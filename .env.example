# Deployer private key (never commit real keys).
#  - Local (base-anvil):  anvil rich wallet #0 below is fine.
#  - Base Sepolia:        use the funded testnet wallet. We reuse the same
#                         testing wallet as the ZKSync docs —
#                         address 0x2c8A01e971d7C51B3B78f9F08c57c45584D96AB2.
#                         Only ETH-for-gas is needed (MockUSDC is minted by
#                         deploy:escrow:sepolia). No-signup faucets:
#                           https://www.ethereum-ecosystem.com/faucets/base-sepolia (pk910 PoW, ≤0.5 ETH/24h)
#                           https://bwarelabs.com/faucets/base-sepolia
#                           https://ethfaucet.com/
#                         CDP faucet (needs Coinbase acct): https://portal.cdp.coinbase.com/products/faucet
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Base Sepolia RPC (public: https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Self.xyz config consumed by deploy-self.ts / deploy-all.ts.
#  - SELF_VERIFIER_ADDRESS unset  → deploy-all.ts deploys a MockGroth16Verifier
#    (always-true) so the testnet demo's identity reads work without the real
#    Groth16 verifier. Set to the real verifier before staging.
#  - SELF_SCOPE: expected Self scope (uint). 0 for the mock/demo path.
SELF_VERIFIER_ADDRESS=
SELF_SCOPE=0

# Base mainnet RPC (public: https://mainnet.base.org)
BASE_RPC_URL=https://mainnet.base.org

# Basescan API key for contract verification (https://basescan.org/myapikey)
BASESCAN_API_KEY=

# ERC-4337 EntryPoint v0.7 (preinstalled on Base — primary)
ENTRYPOINT_V07=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# ERC-4337 EntryPoint v0.6 (legacy, kept for reference)
ENTRYPOINT_V06=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# USDC (Base Sepolia testnet)
USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# USDC (Base mainnet)
USDC_BASE_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# RIP-7212 P-256 precompile address
P256_PRECOMPILE=0x0000000000000000000000000000000000000100

# Permit2 (preinstalled on Base)
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# B20 Factory (Beryl hardfork — Sepolia live 2026-06-18, mainnet 2026-06-25)
# Singleton precompile for creating B20 native tokens.
# See: https://docs.base.org/base-chain/specs/upgrades/beryl/b20
B20_FACTORY_ADDRESS=

# If Cofferdam deploys its own B20 Stablecoin for payroll settlement:
COFFERDAM_B20_STABLECOIN_ADDRESS=
