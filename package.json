{
  "name": "cofferdam-base-contracts",
  "version": "0.1.0",
  "private": true,
  "license": "(MIT OR PROPRIETARY)",
  "author": "Cofferdam Inc.",
  "homepage": "https://github.com/cofferdamxyz/base-contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofferdamxyz/base-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/cofferdamxyz/base-contracts/issues"
  },
  "description": "Cofferdam onchain contracts for Base. Open-source (MIT): ERC-4337 account abstraction, passkey authority, Self.xyz. Proprietary: enterprise payroll escrow (contracts/enterprise/).",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:base-sepolia": "hardhat test --network baseSepolia",
    "deploy:auth:local": "hardhat run scripts/deploy-auth.ts --network localhost",
    "deploy:auth:sepolia": "hardhat run scripts/deploy-auth.ts --network baseSepolia",
    "deploy:self:local": "hardhat run scripts/deploy-self.ts --network localhost",
    "deploy:self:sepolia": "hardhat run scripts/deploy-self.ts --network baseSepolia",
    "deploy:all:local": "hardhat run scripts/deploy-all.ts --network localhost",
    "deploy:all:sepolia": "hardhat run scripts/deploy-all.ts --network baseSepolia",
    "deploy:escrow:local": "hardhat run scripts/deploy-escrow.ts --network localhost",
    "deploy:escrow:sepolia": "hardhat run scripts/deploy-escrow.ts --network baseSepolia",
    "node:start": "base-anvil --fork-url ${BASE_SEPOLIA_RPC_URL:-https://sepolia.base.org} --port 8545",
    "cli": "ts-node cli/index.ts",
    "enterprise:cli": "ts-node contracts/enterprise/enterprise-cli/index.ts",
    "inspect:account": "hardhat run scripts/inspect-account.ts",
    "clean": "hardhat clean",
    "typecheck": "tsc --noEmit",
    "typecheck:enterprise": "tsc --noEmit --project tsconfig.enterprise.json"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.2.0",
    "@openzeppelin/hardhat-upgrades": "^3.5.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^26.0.0",
    "chai": "^4.2.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.8",
    "poseidon-lite": "^0.3.0",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.5.0",
    "viem": "^2.21.0"
  }
}
